{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch Lloyd Product Management API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/server/bin/Debug/net10.0/Lloyd.ProductManagement.Api.dll",
      "cwd": "${workspaceFolder}/server",
      "preLaunchTask": "build-api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5240"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/api/categories"
      }
    }
  ]
}
